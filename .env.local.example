# Project kill switch — set true only to block ingest/generate
PROJECT_SHUTDOWN=false

# Neon Postgres (pooled connection string from console)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# AI provider: openai (default) | local (Ollama on your PC)
AI_PROVIDER=openai

# OpenAI — used when AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Local Ollama — used when AI_PROVIDER=local
# Same machine: http://localhost:11434/v1
# PC w LAN (Mac → Windows): http://192.168.0.200:11434/v1
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_API_KEY=ollama
# LOCAL_AI_MODEL=qwen2.5:32b-instruct-q4_K_M

# Local generation panel (http://localhost:3000/panel) — never enable on Vercel prod
LOCAL_PANEL_ENABLED=true

# Cron auth (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Vercel prod: set to false — AI runs locally via run-generate.mts
# CRON_AI_ENABLED=false

# Daily OpenAI token cap for /api/cron/generate (~750k ≈ $0.25 on gpt-4o-mini)
# GENERATION_DAILY_TOKEN_BUDGET=750000

# Site
# Local dev: http://localhost:3000
# Vercel production: https://tideway.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IndexNow (Bing/Yandex) — must match public/{key}.txt in repo
INDEXNOW_KEY=d4e8f2a91b6c3e7f0a8d5b2c9e1f4a6

# Optional: YouTube Data API
YOUTUBE_API_KEY=

# Reddit API (https://www.reddit.com/prefs/apps — create "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Option A: dedicated bot account (script app)
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Option B: long-lived refresh token (web app)
# REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=web:tideway:v1.0.0 (by /u/YOUR_REDDIT_USERNAME)
