# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider: openai (default) | local (Ollama on your PC)
AI_PROVIDER=openai

# OpenAI — used when AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Local Ollama — used when AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_API_KEY=ollama
# LOCAL_AI_MODEL=qwen2.5:32b-instruct-q4_K_M

# Cron auth (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Site
# Local dev: http://localhost:3000
# Vercel production: https://tideway.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IndexNow (Bing/Yandex) — must match public/{key}.txt in repo
INDEXNOW_KEY=d4e8f2a91b6c3e7f0a8d5b2c9e1f4a6

# Optional: YouTube Data API
YOUTUBE_API_KEY=

# Reddit API (https://www.reddit.com/prefs/apps — create "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Option A: dedicated bot account (script app)
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Option B: long-lived refresh token (web app)
# REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=web:tideway:v1.0.0 (by /u/YOUR_REDDIT_USERNAME)
