# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Cron auth (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Site
# Local dev: http://localhost:3000
# Vercel production: https://tideway.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: YouTube Data API
YOUTUBE_API_KEY=

# Reddit API (https://www.reddit.com/prefs/apps — create "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Option A: dedicated bot account (script app)
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Option B: long-lived refresh token (web app)
# REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=web:tideway:v1.0.0 (by /u/YOUR_REDDIT_USERNAME)
